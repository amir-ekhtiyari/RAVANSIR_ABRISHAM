# Caddy: automatic HTTPS (Let's Encrypt), static/media files, reverse proxy to gunicorn.
# SITE_ADDRESS comes from .env, e.g.  "ravanseirabrisham.ir, www.ravanseirabrisham.ir"  or  ":80"  for a first test by IP.
{
	email {$ACME_EMAIL:admin@localhost}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# www.<domain> -> <domain> (one canonical address for visitors and search engines)
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Hashed static files from collectstatic: cache for a year.
	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Uploaded files (company photos, logo).
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=604800"
		header X-Content-Type-Options nosniff
		file_server
	}

	handle {
		reverse_proxy web:8000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	request_body {
		max_size 10MB
	}

	log {
		output stdout
		format console
	}
}
