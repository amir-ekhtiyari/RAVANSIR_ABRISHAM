# Copy to .env (next to manage.py) and fill in. Never commit .env.

# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=0
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# Full public address, used for canonical links, Open Graph and sitemap.xml (no trailing slash)
SITE_URL=https://example.com
# Admin panel path – change it to something hard to guess
DJANGO_ADMIN_URL=manage-rsa/

# --- Database (empty = SQLite file db.sqlite3) -------------------------------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=

# --- Email: who receives a copy of each consultation request ----------------
CONTACT_NOTIFY_EMAILS=tfahimi54@gmail.com
DEFAULT_FROM_EMAIL=website@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
# Consultation requests allowed per visitor IP per hour
CONTACT_RATE_LIMIT=5
