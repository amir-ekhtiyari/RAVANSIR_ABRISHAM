# Copy to .env (next to manage.py / docker-compose.yml) and fill in. Never commit .env.
# Generate a secret key:  python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Domain & HTTPS (Docker / Caddy) -----------------------------------------
# Domain(s) Caddy serves and gets free HTTPS certificates for (DNS A record must point to this server).
# For a first test by IP without a domain use  SITE_ADDRESS=:80  and  DJANGO_HTTPS=0
SITE_ADDRESS=ravanseirabrisham.ir, www.ravanseirabrisham.ir
ACME_EMAIL=admin@ravanseirabrisham.ir

# --- Django --------------------------------------------------------------------
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=ravanseirabrisham.ir,www.ravanseirabrisham.ir
DJANGO_CSRF_TRUSTED_ORIGINS=https://ravanseirabrisham.ir,https://www.ravanseirabrisham.ir
DJANGO_HTTPS=1
# Full public address, used for canonical links, Open Graph, sitemap.xml and the QR contact card (no trailing slash)
SITE_URL=https://ravanseirabrisham.ir
# Admin panel path – change it to something hard to guess
DJANGO_ADMIN_URL=manage-rsa/

# --- Database --------------------------------------------------------------------
# Docker: the "db" container is created with these values. Local run without Docker: empty POSTGRES_DB = SQLite.
POSTGRES_DB=ravansir_abrisham
POSTGRES_USER=ravansir
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Email: who receives a copy of each consultation request ---------------------
CONTACT_NOTIFY_EMAILS=tfahimi54@gmail.com
DEFAULT_FROM_EMAIL=website@ravanseirabrisham.ir
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
# Consultation requests allowed per visitor IP per hour
CONTACT_RATE_LIMIT=5

# --- Optional: mirrors for servers without direct Docker Hub / PyPI access ---------
